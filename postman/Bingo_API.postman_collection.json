		{
			"name": "Partidas",
			"description": "Enfoque A: al crear la partida se generan N cartones con partidaId.\norganizacionId y operadorId salen del JWT (mesa: administrador|operador).\nEstados: pendiente, en_curso, finalizada, cancelada.",
			"item": [
				{
					"name": "Crear",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nombre\": \"Bingo navideño\",\n  \"numero\": 2,\n  \"fecha\": \"2026-12-20 20:00:00\",\n  \"precioCarton\": 50000,\n  \"cantidadCartones\": 10,\n  \"modalidades\": [\n    { \"modalidad\": \"linea\", \"premio\": 1000000 },\n    { \"modalidad\": \"equis\", \"premio\": 5000000 },\n    { \"modalidad\": \"completa\", \"premio\": 20000000 }\n  ]\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": "{{base_url}}partidas/crear",
						"description": "Crea la partida en estado pendiente y genera cantidadCartones disponibles."
					},
					"response": []
				},
				{
					"name": "Listar todos",
					"request": {
						"method": "GET",
						"header": [],
						"url": "{{base_url}}partidas/listar"
					},
					"response": []
				},
				{
