{
	"info": {
		"name": "Bingo API",
		"description": "API local de Bingo Virtual.\n\nBase URL: `{{base_url}}`\nFormato: `/{recurso}/{accion}`\n\nAuth: `POST /auth/login` → pegar `token` en el environment.\nAuthGuard exige Bearer en casi todo. Públicos: login, ciudades/listar, realtime/config, organizaciones/crear, webhook OpenPay, retorno PSE.\nSSE: `?token=` además de Bearer.\n\nImporta el environment **Bingo Local** y selecciónalo antes de probar.\nLas variables se editan a mano; esta colección no las modifica con scripts.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{ "key": "token", "value": "{{token}}", "type": "string" }
		]
	},
	"item": [
		{
			"name": "Auth",
			"description": "JWT. Login con correo o celular + password dentro de una organización.",
			"item": [
				{
					"name": "Login",
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"organizacionId\": {{organizacionId}},\n  \"identificador\": \"{{usuarioCorreo}}\",\n  \"password\": \"{{password}}\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": "{{base_url}}auth/login",
						"description": "identificador = correo o celular. Copia el token de la respuesta a la variable `token` del environment. Rutas protegidas heredan Bearer de la colección."
					},
					"response": []
				},
				{
					"name": "Registro jugador",
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"organizacionId\": {{organizacionId}},\n  \"ciudadId\": {{ciudadId}},\n  \"nombre\": \"{{usuarioNombre}}\",\n  \"apellido\": \"{{usuarioApellido}}\",\n  \"celular\": \"{{usuarioCelular}}\",\n  \"correo\": \"nuevo.jugador@bingo.local\",\n  \"password\": \"{{password}}\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": "{{base_url}}auth/registro",
						"description": "Público. Siempre crea rol jugador y devuelve token + usuario."
					},
					"response": []
				},
				{
					"name": "Yo",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{ "key": "token", "value": "{{token}}", "type": "string" }
							]
						},
						"method": "GET",
						"header": [],
						"url": "{{base_url}}auth/yo",
						"description": "Devuelve el usuario del Bearer token."
					},
					"response": []
				}
			]
		},
		{
			"name": "Cartones",
			"description": "Cartones 5x5 asociados a una organización.\n\nEstados: `disponible`, `reservado`, `vendido`, `anulado`.\nPUT: disponible/reservado/vendido.\nDELETE: anula un cartón vendido.",
			"item": [
				{
					"name": "Crear",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"organizacionId\": {{organizacionId}}\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": "{{base_url}}cartones/crear",
						"description": "El administrador crea inventario. usuarioId queda null hasta reservar/vender."
					},
					"response": []
				},
				{
					"name": "Listar todos",
					"request": {
						"method": "GET",
						"header": [],
						"url": "{{base_url}}cartones/listar"
					},
					"response": []
				},
				{
					"name": "Listar por organización",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}cartones/listar?organizacionId={{organizacionId}}",
							"host": ["{{base_url}}cartones"],
							"path": ["listar"],
							"query": [
								{ "key": "organizacionId", "value": "{{organizacionId}}" }
							]
						}
					},
					"response": []
				},
				{
					"name": "Listar por usuario",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}cartones/listar?usuarioId={{usuarioId}}",
							"host": ["{{base_url}}cartones"],
							"path": ["listar"],
							"query": [
								{ "key": "usuarioId", "value": "{{usuarioId}}" }
							]
						}
					},
					"response": []
				},
				{
					"name": "Buscar",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}cartones/buscar?id={{cartonId}}",
							"host": ["{{base_url}}cartones"],
							"path": ["buscar"],
							"query": [
								{ "key": "id", "value": "{{cartonId}}" }
							]
						}
					},
					"response": []
				},
				{
					"name": "Actualizar estado",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"estado\": \"vendido\",\n  \"usuarioId\": {{usuarioId}}\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{base_url}}cartones/actualizar?id={{cartonId}}",
							"host": ["{{base_url}}cartones"],
							"path": ["actualizar"],
							"query": [
								{ "key": "id", "value": "{{cartonId}}" }
							]
						},
						"description": "Vender/reservar: estado + usuarioId. Liberar: {\"estado\":\"disponible\"}."
					},
					"response": []
				},
				{
					"name": "Anular",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{base_url}}cartones/eliminar?id={{cartonId}}",
							"host": ["{{base_url}}cartones"],
							"path": ["eliminar"],
							"query": [
								{ "key": "id", "value": "{{cartonId}}" }
							]
						}
					},
					"response": []
				}
			]
		},
