		{
			"name": "Ventas",
			"description": "Canales: manual_operador, openpay_pse (próximo), comprobante (próximo).\nVenta manual crea pago aprobado + cartón vendido + cartonesConfirmados++.",
			"item": [
				{
					"name": "Venta manual",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"cartonId\": {{cartonId}},\n  \"usuarioId\": {{usuarioId}}\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": "{{base_url}}ventas/manual",
						"description": "usuarioId = comprador. Operador = JWT (mesa). Monto = precioCarton de la partida."
					},
					"response": []
				},
				{
					"name": "Iniciar PSE (OpenPay)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"cartonId\": {{cartonId}},\n  \"redirectUrl\": \"https://bingo.local/pago-ok\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": "{{base_url}}ventas/pse",
						"description": "Reserva el cartón, crea pago openpay_pse pendiente y devuelve pse.url para redirigir al banco.\nDocs: charges method=bank_account + webhooks charge.succeeded/failed."
					},
					"response": []
				},
				{
					"name": "Webhook OpenPay",
					"request": {
						"auth": {
							"type": "basic",
							"basic": [
								{ "key": "username", "value": "{{openpayWebhookUser}}", "type": "string" },
								{ "key": "password", "value": "{{openpayWebhookPass}}", "type": "string" }
							]
						},
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"type\": \"charge.succeeded\",\n  \"event_date\": \"2026-10-27T18:00:00-05:00\",\n  \"transaction\": {\n    \"id\": \"tr_ejemplo\",\n    \"method\": \"bank_account\",\n    \"status\": \"completed\",\n    \"order_id\": \"bingo-pago-{{pagoId}}\",\n    \"amount\": 5000,\n    \"currency\": \"COP\"\n  }\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": "{{base_url}}ventas/webhook-openpay",
						"description": "URL a registrar en Dashboard OpenPay. Basic Auth = OPENPAY_WEBHOOK_USER/PASS.\nTambién acepta type=verification con verification_code."
					},
					"response": []
				},
				{
					"name": "Subir comprobante",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{ "key": "cartonId", "value": "{{cartonId}}", "type": "text" },
								{ "key": "comprobante", "type": "file", "src": [] }
							]
						},
						"url": "{{base_url}}ventas/comprobante",
						"description": "form-data: cartonId + comprobante (JPG/PNG/WEBP ≤ 5MB). Jugador = JWT.\nCartón → reservado. Pago → pendiente. Guarda URL en comprobanteUrl."
					},
					"response": []
				},
				{
					"name": "Aprobar comprobante",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"pagoId\": {{pagoId}}\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": "{{base_url}}ventas/aprobar-comprobante",
						"description": "Pago aprobado + cartón vendido + cartonesConfirmados++."
					},
					"response": []
				},
				{
					"name": "Rechazar comprobante",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"pagoId\": {{pagoId}}\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": "{{base_url}}ventas/rechazar-comprobante",
						"description": "Pago rechazado + cartón liberado (disponible)."
					},
					"response": []
				}
			]
		},
		{
			"name": "Push",
			"description": "Web Push PWA. VAPID pública sin auth; suscribir/desuscribir con Bearer.",
			"item": [
				{
					"name": "VAPID pública",
					"request": {
						"auth": { "type": "noauth" },
						"method": "GET",
						"header": [],
						"url": "{{base_url}}push/vapid-publica"
					},
					"response": []
				},
				{
					"name": "Suscribir",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
